# ============================================================
# AI Sales Intelligence — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# The alert service will automatically load this file on startup.
# ============================================================

# --- Stakeholder Email Recipients ---
# Comma-separated list of recipient email addresses.
# Example: stakeholder1@company.com, ceo@company.com
STAKEHOLDER_EMAIL=stakeholder@example.com

# --- SMTP Sender Configuration ---
# Gmail users: use an App Password (not your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_alerts_email@gmail.com
SENDER_PASSWORD=doak geqe gklv abpi
