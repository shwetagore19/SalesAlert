# Database Configuration (Defaults to SQLite if not provided)
DATABASE_URL=sqlite:///./sales_intelligence.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_intelligence_db

# LLM API Key (OpenAI / Gemini)
LLM_API_KEY=your_openai_or_gemini_api_key_here

# Email SMTP Credentials (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
MANAGER_EMAIL=manager@company.com

# Twilio WhatsApp Credentials (Optional)
WHATSAPP_ACCOUNT_SID=your_twilio_sid
WHATSAPP_AUTH_TOKEN=your_twilio_auth_token
WHATSAPP_FROM=whatsapp:+14155238886
MANAGER_PHONE=whatsapp:+919876543210

# Scheduler Switch
ENABLE_SCHEDULER=false
